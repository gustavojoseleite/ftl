<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://relaxng.org/ns/structure/1.0"?>
<package format="3">
  <name>ftl_gz</name>
  <version>0.1.0</version>
  <description>
    Cenários de teste do FTL no Gazebo Harmonic: qual mundo, quais veículos lideram e seguem,
    onde começam. Sobe a simulação e, se quiser, os nós do FTL do ftl_bringup.
  </description>
  <maintainer email="gujoseleite@gmail.com">Gustavo</maintainer>
  <license>Apache-2.0</license>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <!-- O único pacote do FTL que sabe que existe um simulador. -->
  <exec_depend>agri_gz_bringup</exec_depend>
  <exec_depend>agri_gz_worlds</exec_depend>
  <exec_depend>autonomous_tractor_gz</exec_depend>
  <exec_depend>ftl_bringup</exec_depend>
  <exec_depend>launch</exec_depend>
  <exec_depend>pickup_gz</exec_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
