<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://relaxng.org/ns/structure/1.0"?>
<package format="3">
  <name>ftl_follower</name>
  <version>0.1.0</version>
  <description>
    `Follow the leader`: um estimador de pose para cada veículo (GNSS + IMU + odometria em um
    único referencial local comum) e um seguidor que dirige pelo caminho do veículo da frente
    a um espaçamento fixo. Não conhece nenhum simulador.
  </description>
  <maintainer email="gujoseleite@gmail.com">Gustavo</maintainer>
  <license>Apache-2.0</license>

  <!-- Só tópicos no namespace do veículo (odom, imu/data, gnss/fix na entrada,
       cmd_vel na saída), o TF do veículo para o deslocamento da antena e o ftl/state
       do veículo da frente. -->
  <exec_depend>geometry_msgs</exec_depend>
  <exec_depend>nav_msgs</exec_depend>
  <exec_depend>rclpy</exec_depend>
  <exec_depend>sensor_msgs</exec_depend>
  <exec_depend>std_msgs</exec_depend>
  <exec_depend>tf2_ros</exec_depend>

  <test_depend>ament_flake8</test_depend>
  <test_depend>ament_pep257</test_depend>
  <test_depend>python3-pytest</test_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
