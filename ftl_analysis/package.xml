<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://relaxng.org/ns/structure/1.0"?>
<package format="3">
  <name>ftl_analysis</name>
  <version>0.1.0</version>
  <description>Análise das campanhas do ftl: lê os bags de cada execução e gera as métricas por trecho e por trator, com média e intervalo de confiança de 95%, em tabelas CSV e LaTeX e em figura PDF.</description>
  <maintainer email="gujoseleite@gmail.com">Gustavo</maintainer>
  <license>Apache-2.0</license>

  <exec_depend>ftl_bringup</exec_depend>
  <exec_depend>ftl_route_driver</exec_depend>
  <exec_depend>rosbag2_py</exec_depend>
  <exec_depend>rclpy</exec_depend>
  <exec_depend>rosidl_runtime_py</exec_depend>
  <exec_depend>python3-numpy</exec_depend>
  <exec_depend>python3-pandas</exec_depend>
  <exec_depend>python3-scipy</exec_depend>
  <exec_depend>python3-matplotlib</exec_depend>
  <exec_depend>python3-yaml</exec_depend>

  <test_depend>ament_flake8</test_depend>
  <test_depend>ament_pep257</test_depend>
  <test_depend>python3-pytest</test_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
