<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://relaxng.org/ns/structure/1.0"?>
<package format="3">
  <name>ftl_localization</name>
  <version>0.1.0</version>
  <description>Localização por veículo: o UKF do robot_localization publica o ftl/state com covariância.</description>
  <maintainer email="gujoseleite@gmail.com">Gustavo</maintainer>
  <license>Apache-2.0</license>

  <exec_depend>robot_localization</exec_depend>
  <exec_depend>launch</exec_depend>
  <exec_depend>launch_ros</exec_depend>
  <exec_depend>ament_index_python</exec_depend>
  <exec_depend>rclpy</exec_depend>
  <exec_depend>nav_msgs</exec_depend>
  <exec_depend>geometry_msgs</exec_depend>
  <exec_depend>sensor_msgs</exec_depend>
  <exec_depend>ftl_follower_pure_pursuit</exec_depend>
  <exec_depend>tf2_ros_py</exec_depend>

  <test_depend>ament_flake8</test_depend>
