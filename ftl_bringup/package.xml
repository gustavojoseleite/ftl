<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://relaxng.org/ns/structure/1.0"?>
<package format="3">
  <name>ftl_bringup</name>
  <version>0.1.0</version>
  <description>
    Os nós do FTL e seus parâmetros, em um só launch. Roda igual contra o simulador ou as
    máquinas reais: nada aqui depende do Gazebo.
  </description>
  <maintainer email="gujoseleite@gmail.com">Gustavo</maintainer>
  <license>Apache-2.0</license>

  <buildtool_depend>ament_cmake</buildtool_depend>
  <buildtool_depend>ament_cmake_python</buildtool_depend>

  <!-- Sem dependência de simulador, de propósito: os cenários que precisam do Gazebo
       ficam no ftl_gz, que depende deste pacote e nunca o contrário. -->
  <exec_depend>launch</exec_depend>
  <exec_depend>launch_ros</exec_depend>
  <exec_depend>ftl_follower_pure_pursuit</exec_depend>
  <exec_depend>road_follow</exec_depend>
  <exec_depend>ftl_route_driver</exec_depend>
  <exec_depend>agri_sensor_degradation</exec_depend>
  <exec_depend>agri_gz_bringup</exec_depend>
  <exec_depend>agri_gz_worlds</exec_depend>
  <exec_depend>python3-yaml</exec_depend>
  <exec_depend>std_msgs</exec_depend>
  <exec_depend>rcl_interfaces</exec_depend>
  <exec_depend>ament_index_python</exec_depend>

  <test_depend>ament_cmake_pytest</test_depend>
  <test_depend>ament_flake8</test_depend>
  <test_depend>ament_pep257</test_depend>
  <test_depend>python3-pytest</test_depend>
  <test_depend>python3-yaml</test_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
