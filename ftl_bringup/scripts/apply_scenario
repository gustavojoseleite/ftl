#!/usr/bin/env python3
"""Publica a configuração do experimento e aplica o cenário nos nós dos veículos.

    apply_scenario <config.yaml>

O texto do arquivo vai para `/experiment/config` (retido). Depois, em cada veículo, ajusta por
serviço de parâmetros os perfis e sementes dos sensores, o perfil da câmera dos seguidores e o
atuador do `cmd_vel_limiter`. Tenta até os nós existirem e segue vivo para manter o tópico.
"""
import sys
import time
from pathlib import Path

import rclpy
from rclpy.utilities import remove_ros_args
from rcl_interfaces.msg import Parameter, ParameterType, ParameterValue
from rcl_interfaces.srv import SetParameters
from rclpy.qos import DurabilityPolicy, QoSProfile
from std_msgs.msg import String

from ftl_bringup import scenario

DEADLINE = 240.0
RETRY = 2.0


def parameter(name, value):
    msg = Parameter(name=name)
    if isinstance(value, bool):
        msg.value = ParameterValue(type=ParameterType.PARAMETER_BOOL, bool_value=value)
    elif isinstance(value, int):
        msg.value = ParameterValue(type=ParameterType.PARAMETER_INTEGER, integer_value=value)
    elif isinstance(value, float):
        msg.value = ParameterValue(type=ParameterType.PARAMETER_DOUBLE, double_value=value)
    else:
        msg.value = ParameterValue(type=ParameterType.PARAMETER_STRING, string_value=value)
    return msg


def plan(config):
    """Devolve {caminho do nó: {parâmetro: valor}} para todos os veículos."""
    convoy, degradation, actuator = config['convoy'], config['degradation'], config['actuator']
    leader = convoy['leader']
    vehicles = [leader] + [f"tractor_{n + 1}" for n in range(convoy['followers'])]
    targets = {}
    for index, vehicle in enumerate(vehicles):
        for sensor in ('gnss', 'imu', 'odometry'):
            values = {'seed': degradation['seed'] + index}
            if degradation[sensor]:
                values['profile'] = degradation[sensor]
            targets[f'/{vehicle}/{sensor}'] = values
        if index > 0 and degradation['camera']:
            targets[f'/{vehicle}/distortion_camera_front'] = {'profile': degradation['camera']}
        targets[f'/{vehicle}/cmd_vel_limiter'] = {
            'actuator.steering_rate': actuator['steering_rate'],
            'actuator.time_constant': actuator['time_constant'],
            'actuator.enabled': actuator['enabled'],
        }
    return targets


def main():
    arguments = remove_ros_args(sys.argv)[1:]
    if len(arguments) != 1:
        sys.exit('usage: apply_scenario <config.yaml>')
    path = Path(arguments[0])
    config = scenario.read(path)
    rclpy.init()
    node = rclpy.create_node('apply_scenario')
    log = node.get_logger()
    publisher = node.create_publisher(String, '/experiment/config', QoSProfile(
        depth=1, durability=DurabilityPolicy.TRANSIENT_LOCAL))
    publisher.publish(String(data=path.read_text(encoding='utf-8')))

    pending = plan(config)
    clients = {target: node.create_client(SetParameters, f'{target}/set_parameters')
               for target in pending}
    applied, failed = [], []
    start = time.monotonic()
    while pending and time.monotonic() - start < DEADLINE:
        for target in list(pending):
            client = clients[target]
            if not client.service_is_ready():
                continue
            values = pending[target]
            future = client.call_async(SetParameters.Request(
                parameters=[parameter(name, value) for name, value in values.items()]))
            rclpy.spin_until_future_complete(node, future, timeout_sec=5.0)
            if not future.done() or future.result() is None:
                continue
            del pending[target]
            for (name, value), result in zip(values.items(), future.result().results):
                if result.successful:
                    applied.append(f'{target}:{name}={value}')
                else:
                    failed.append(f'{target}:{name} ({result.reason})')
        rclpy.spin_once(node, timeout_sec=RETRY if pending else 0.0)
    log.info(f'applied {len(applied)} parameters: {", ".join(applied)}')
    if failed:
        log.warning(f'rejected: {", ".join(failed)}')
    if pending:
        log.warning(f'nodes never appeared: {", ".join(sorted(pending))}')
    try:
        rclpy.spin(node)
    except KeyboardInterrupt:
        pass
    node.destroy_node()
    if rclpy.ok():
        rclpy.shutdown()


if __name__ == '__main__':
    main()
