<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://relaxng.org/ns/structure/1.0"?>
<package format="3">
  <name>road_follow</name>
  <version>0.1.0</version>
  <description>
    Dirige um veículo pelos carreadores da fazenda de citros pela câmera: acha as bordas da
    estrada, guia por perseguição pura (`pure pursuit`) e tira da odometria os entroncamentos
    da rota. Usado pelo FTL para dirigir o líder.
  </description>
  <maintainer email="gujoseleite@gmail.com">Gustavo</maintainer>
  <license>Apache-2.0</license>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <!-- Só tópicos: camera_front/*, odom e gnss/fix na entrada, cmd_vel na saída, mais o
       TF do próprio veículo para a altura da câmera. Sem dependência do simulador. -->
  <exec_depend>geometry_msgs</exec_depend>
  <exec_depend>nav_msgs</exec_depend>
  <exec_depend>python3-numpy</exec_depend>
  <exec_depend>rclpy</exec_depend>
  <exec_depend>sensor_msgs</exec_depend>
  <exec_depend>tf2_ros</exec_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
